#!/usr/bin/env python3
"""Check that commit subjects parse as changelog entries.

The release log is the changelog (docs/agent/dev.md, "Commits: the
subject is the changelog"), which only works if every subject parses.
This is the deterministic half of that: the same rules, applied the same
way, by a hook before the commit exists and by CI before it merges.

It also refuses credit lines for the tool that helped write a change:
a Co-Authored-By trailer, a "Generated with Claude Code" footer, its
link, or an Anthropic noreply address. That is checked in whole
messages and in pull request descriptions, not just in subjects.
So is the em dash, which the published release notes do not use.

Four ways in, one rule set:

    tools/commit-lint --message .git/COMMIT_EDITMSG   one message, for the hook
    tools/commit-lint --range origin/main..HEAD       a range, for CI and releases
    tools/commit-lint --title "feat(photos): ..."     a PR title, which squash
                                                      merging turns into a subject
    tools/commit-lint --body "## Summary ..."         a PR description
"""

from __future__ import annotations

import argparse
import re
import subprocess
import sys

# Types, and where each one lands in the changelog. The empty string
# means it is not shown; internal work is still committed, just not
# announced.
TYPES = {
    "feat": "Added",
    "fix": "Fixed",
    "security": "Security",
    "perf": "Performance",
    "docs": "Documentation",
    "refactor": "",
    "test": "",
    "chore": "",
    "ci": "",
    "style": "",
    "build": "",
}

# Scopes, and what a reader sees. Keep in step with the table in
# docs/agent/dev.md; a test asserts the two agree.
SCOPES = {
    # Stacklets, by the id the directory and the CLI use.
    "agent": "Agent Stacklet",
    "ai": "AI Stacklet",
    "backup": "Backup Stacklet",
    "chatai": "ChatAI Stacklet",
    "code": "Code Stacklet",
    "core": "Core Stacklet",
    "docs": "Docs Stacklet",
    "infra": "Infra Stacklet",
    "memory": "Memory Stacklet",
    "messages": "Messages Stacklet",
    "photos": "Photos Stacklet",
    # Bots, by the name in their bot.toml with the -bot suffix dropped.
    "archivist": "Archivist Bot",
    "mail": "Mail Bot",
    "scribe": "Scribe Bot",
    "stacker": "Stacker Bot",
    # Components that are neither: the stacklet or bot that owns them.
    "curator": "Memory Stacklet",
    "wiki": "Memory Stacklet",
    "diary": "Memory Stacklet",
    "capture": "Archivist Bot",
    "voice": "AI Stacklet",
    # The framework itself.
    "stack": "stack CLI",
    "cli": "stack CLI",
    "doctor": "stack CLI",
    "update": "stack CLI",
    "install": "stack CLI",
    "web": "web fetch",
}


SUBJECT_LIMIT = 72

HEADER = re.compile(
    r"^(?P<type>[a-z]+)"
    r"(?:\((?P<scope>[a-z0-9-]+)\))?"
    r"(?P<breaking>!)?"
    r": (?P<subject>.+?)"
    r"(?: \(#(?P<pr>\d+)\))?$"
)

# Git writes these itself, or they are machine-made and never reach a
# changelog. Linting them would only teach people to pass --no-verify.
EXEMPT = re.compile(r"^(Merge |Revert \"|fixup! |squash! |amend! |Bumps )")


def check(header: str) -> list[str]:
    """Every rule this subject breaks, in the order a reader would fix them."""
    header = header.rstrip()
    if not header or EXEMPT.match(header):
        return []

    match = HEADER.match(header)
    if not match:
        return [
            "does not parse as <type>(<scope>): <subject>",
            f"  types: {', '.join(sorted(TYPES))}",
            "  example: fix(photos): stop the upload stalling on a slow phone",
        ]

    problems = []
    kind, scope, subject = match["type"], match["scope"], match["subject"]

    if kind not in TYPES:
        problems.append(
            f"'{kind}' is not a type. Use one of: {', '.join(sorted(TYPES))}")

    # A scope exists to group entries in the changelog, so it is only
    # checked for types that appear there. `chore(release)` and
    # `test(stack)` name something useful to a developer and nothing to a
    # reader, and policing them would be bureaucracy.
    #
    # Documentation is shown but scoped by document rather than by
    # stacklet, so docs(readme) and docs(admin-guide) are fine.
    groups_by_scope = bool(TYPES.get(kind)) and kind != "docs"
    if scope and groups_by_scope and scope not in SCOPES:
        problems.append(
            f"'{scope}' is not a scope. Use one of: {', '.join(sorted(SCOPES))}"
            " (or no scope at all)")

    # A squash merge appends " (#106)" after CI has checked the title, so
    # the number GitHub adds is not the author's to budget for.
    length = len(header) - (len(f" (#{match['pr']})") if match["pr"] else 0)
    if length > SUBJECT_LIMIT:
        problems.append(
            f"{length} characters, limit is {SUBJECT_LIMIT}")

    if subject[:1].isupper():
        problems.append("starts with a capital; the subject is a sentence "
                        "fragment, not a title")

    if subject.endswith("."):
        problems.append("ends with a full stop")

    return problems


# Credit lines for the tool, never a description of it: "In Claude Code
# the LSP tool is deferred" is documentation and must pass, which is why
# the product name alone is not a pattern.
ATTRIBUTION = [
    (re.compile(r"^\s*co-authored-by:", re.I | re.M),
     "a Co-Authored-By trailer; commits here carry none"),
    (re.compile(r"generated\s+(with|by)\s+\[?claude", re.I),
     "a 'Generated with Claude Code' line"),
    (re.compile(r"claude\.com/claude-code", re.I),
     "a link to claude.com/claude-code"),
    (re.compile(r"noreply@anthropic\.com", re.I),
     "an anthropic.com noreply address"),
]


def attribution(text: str) -> list[str]:
    """Every credit line for the tool found in a message or description."""
    return [why for pattern, why in ATTRIBUTION if pattern.search(text)]


# Subjects and bodies are quoted verbatim into the release notes, which
# use no em dashes. Only U+2014 is refused: an en dash in a range such
# as "1–2" and a plain hyphen are different characters and pass.
EM_DASH = "\u2014"


def em_dashes(text: str) -> list[str]:
    """The em dash rule, for a subject, a whole message or a description."""
    if EM_DASH in text:
        return [f"an em dash ({EM_DASH}); use a comma, colon, period "
                "or parentheses instead"]
    return []


def without_comments(message: str) -> str:
    """What git keeps of an edited message: comment lines are stripped
    before the commit exists, and everything below the scissors goes."""
    kept = []
    for line in message.splitlines():
        if line.startswith("# ------------------------ >8"):
            break
        if not line.startswith("#"):
            kept.append(line)
    return "\n".join(kept)


def say(message: str, err: bool = False) -> None:
    print(message, file=sys.stderr if err else sys.stdout, flush=True)


def report(header: str, problems: list[str], where: str = "") -> None:
    location = f"{where}  " if where else ""
    print(f"\n  ✗ {location}{header}", file=sys.stderr)
    for problem in problems:
        print(f"      {problem}", file=sys.stderr)


def messages_in(rev_range: str) -> list[tuple[str, str]]:
    """Whole messages in a range, read from the repository you are standing in.

    Not from the repository this script lives in: those are the same
    thing in normal use, and letting the caller choose means a release
    script, or a test, can point it at another checkout.
    """
    result = subprocess.run(
        ["git", "log", "--no-merges", "--format=%h%x00%B%x1e", rev_range],
        capture_output=True, text=True,
    )
    if result.returncode != 0:
        print(result.stderr.strip(), file=sys.stderr)
        sys.exit(2)
    pairs = []
    for record in result.stdout.split("\x1e"):
        if record.strip():
            sha, _, message = record.strip("\n").partition("\0")
            pairs.append((sha, message))
    return pairs


def main() -> int:
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    source = parser.add_mutually_exclusive_group(required=True)
    source.add_argument("--message", help="File holding one commit message")
    source.add_argument("--range", help="Revision range, e.g. origin/main..HEAD")
    source.add_argument("--title", help="A pull request title")
    source.add_argument("--body", help="A pull request description")
    args = parser.parse_args()

    failures = 0

    if args.message:
        with open(args.message, encoding="utf-8") as f:
            message = without_comments(f.read())
        header = message.split("\n", 1)[0]
        problems = check(header) + attribution(message) + em_dashes(message)
        if problems:
            report(header.rstrip(), problems)
            failures = 1

    elif args.body is not None:
        problems = attribution(args.body) + em_dashes(args.body)
        if problems:
            report("pull request description", problems)
            failures = 1

    elif args.title:
        problems = check(args.title) + em_dashes(args.title)
        if problems:
            report(args.title, problems)
            failures = 1

    else:
        # An empty range is how this guard dies quietly: a shallow clone
        # or a bad base leaves nothing to check and the step goes green
        # having read nothing. Say what was checked, and refuse to pass
        # on nothing.
        pairs = messages_in(args.range)
        if not pairs:
            say(f"\n  \u2717 no commits in {args.range}", err=True)
            say("      Nothing was checked. A shallow checkout or a wrong "
                "base makes this guard pass blind.", err=True)
            return 1
        for sha, message in pairs:
            subject = message.split("\n", 1)[0]
            problems = check(subject) + attribution(message) + em_dashes(message)
            if problems:
                report(subject, problems, where=sha)
                failures += 1
        if not failures:
            say(f"  {len(pairs)} subject(s) checked, all parse")

    if failures:
        print(f"\n  {failures} message(s) to fix. The rules and the reasoning:"
              f"\n  docs/agent/dev.md, \"Commits: the subject is the changelog\"\n",
              file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
