# User configuration — never commit
stack.toml
config.sh
users.toml
# …except the test instance's config, which is checked in.
!tests/e2e/instance/stack.toml
!tests/e2e/instance/users.toml

# Runtime state — generated by stack CLI
.stack/

# Per-stacklet runtime state — never commit
**/.state/

# Per-stacklet secrets — never commit
**/.env

# macOS
.DS_Store
**/.DS_Store

# Design docs (work in progress)
/design/

# Python
__pycache__/
*.pyc
*.pyo
.python-version

# Editor
.vscode/
.idea/
*.swp
*.swo

# Auto-generated secrets — never commit
.stack/secrets.toml

# Test artifacts
.coverage
htmlcov/
.pytest_cache/

# Pipeline-eval per-run artifacts (OCR text, classification JSON,
# scorecards) — written by `stacktests eval`, never committed.
tests/e2e/eval/runs/

# AI assistant. Local settings and transcripts stay out, but the LSP plugin
# is repo configuration: it makes agents read this codebase with a language
# server instead of grep, so every clone should get it.
# Git cannot re-include a file whose parent directory is excluded, so these
# ignore directory *contents* and re-open the one path down to the plugin.
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/famstack-lsp/

# Extension stacklets live in ~/<product>-extensions, not here. This is
# the obvious place to try anyway, so keep anything dropped here out of
# git rather than in someone's next commit.
/extensions/

# Internal development notes
impl/

# JetBrains
*.iml

**CLAUDE.md
**AGENT.md
**AGENTS.md
# …except the repo's canonical agent guide at the root, the CLAUDE.md
# that loads it into Claude Code, and the family agent's workspace
# guide, which is product content the agent stacklet ships.
!/AGENTS.md
!/CLAUDE.md
!/stacklets/agent/workspace/AGENTS.md
# Local planning workspace (Nimbalyst) — not product source
nimbalyst-local/

# Rendered test corpora — the spec is the source of truth, the audio
# and images it renders are disposable artifacts.
tools/family-memories/out/

# Nimbalyst editor scratch (screenshots, transcript images)
.nimbalyst/
