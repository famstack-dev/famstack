{
  "providers": {
    "custom": {
      "api_base": "${AGENT_OPENAI_URL}",
      "api_key": "${AGENT_OPENAI_KEY}"
    },
    "openai": {
      "api_base": "${AGENT_WHISPER_URL}",
      "api_key": "${AGENT_WHISPER_KEY}"
    }
  },
  "transcription": {
    "provider": "openai",
    "model": "${AGENT_WHISPER_MODEL}"
  },
  "model_presets": {
    "primary": {
      "provider": "custom",
      "model": "${AGENT_MODEL}",
      "context_window_tokens": 32768
    }
  },
  "agents": {
    "defaults": {
      "model_preset": "primary",
      "max_tool_iterations": 12,
      "disabled_skills": ["memory", "my"]
    }
  },
  "tools": {
    "exec": {"enable": true, "allowed_env_keys": ["PATH"], "deny_patterns": ["\\blist\\s+delete\\b.*\\s--y"]},
    "web": {"enable": false},
    "file": {"enable": true},
    "cli_apps": {"enable": false},
    "my": {"enable": false},
    "image_generation": {"enable": false}
  },
  "channels": {
    "sendProgress": false,
    "sendToolHints": true,
    "showReasoning": false,
    "matrix": {
      "enabled": true,
      "homeserver": "${AGENT_MATRIX_HOMESERVER}",
      "userId": "@${AGENT_BOT_ID}:${AGENT_MATRIX_SERVER_NAME}",
      "password": "${AGENT_MATRIX_PASSWORD}",
      "e2eeEnabled": true,
      "allowFrom": ["*"],
      "groupPolicy": "mention"
    },
    "websocket": {"enabled": false}
  }
}
