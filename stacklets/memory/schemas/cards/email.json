{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:famstack:card:email",
  "title": "email",
  "description": "An email thread (ADR-017 §6, record). Never carries a capture_id: the thread's first Message-ID is its resource.",
  "$ref": "urn:famstack:card:base",
  "properties": {
    "type": {
      "const": "email"
    },
    "card_id": {
      "type": "string",
      "pattern": "^email-[a-z0-9][a-z0-9._-]*$",
      "readOnly": true
    },
    "kind": {
      "not": {}
    },
    "capture_id": {
      "not": {}
    },
    "resource": {
      "description": "The thread's first message, mid:<Message-ID>.",
      "type": "string",
      "pattern": "^mid:",
      "readOnly": true
    },
    "model": {
      "description": "The model that read the source.",
      "type": "string",
      "readOnly": true
    },
    "timestamp": {
      "$ref": "urn:famstack:card:base#/$defs/timestamp",
      "readOnly": true
    }
  },
  "required": [
    "timestamp"
  ]
}
