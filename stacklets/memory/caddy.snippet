# stacklets/memory/caddy.snippet
#
# The family wiki (Quartz rendering the family vault) lives at
# memory.{$STACK_DOMAIN}, the URL the stack hands out for this stacklet:
# the wiki hint, and core's /go/topic links. It goes to core's door
# for the wiki (stack-core-tools:8070, core's tools-server/wiki_door.py),
# never to the wiki container itself: the wiki shows every document and
# diary entry, so it opens for paired devices only. Core forwards those
# to the wiki at the root.

memory.{$STACK_DOMAIN} {
    reverse_proxy stack-core-tools:8070
}

# wiki.{$STACK_DOMAIN} is what people type for the family wiki. It sends
# the browser to the same page here. The redirect is temporary (302): a
# permanent one is kept by browsers for good, which would get in the way
# if the names change again.
wiki.{$STACK_DOMAIN} {
    redir {scheme}://memory.{$STACK_DOMAIN}{uri}
}
