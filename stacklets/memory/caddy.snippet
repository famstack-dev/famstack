# stacklets/memory/caddy.snippet
#
# One route. The family wiki (Quartz rendering the family vault) lives at
# memory.{$STACK_DOMAIN}, the URL the stack hands out for this stacklet:
# the wiki hint, and core's /go/topic links. Caddy runs on the stack
# network so the backend is the container name; the in-container port is
# Quartz's preview server default (8080), not the published host port.
#
# No auth here, matching the rest of the family-facing stacklets
# (photos, docs, messages). The LAN is the perimeter. Add `basicauth`
# inside this block if you ever want to gate the vault separately.

memory.{$STACK_DOMAIN} {
    reverse_proxy stack-memory-wiki:8080
}

# wiki.{$STACK_DOMAIN} is what people type for the family wiki. It sends
# the browser to the same page here. The redirect is temporary (302): a
# permanent one is kept by browsers for good, which would get in the way
# if the names change again.
wiki.{$STACK_DOMAIN} {
    redir {scheme}://memory.{$STACK_DOMAIN}{uri}
}
