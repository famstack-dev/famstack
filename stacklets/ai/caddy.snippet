# stacklets/ai/caddy.snippet
#
# The AI endpoints by name, for clients on the LAN: speech to text, and
# the OpenAI-compatible API of oMLX, which also speaks (/v1/audio/speech).
#
# whisper-server and oMLX run natively on the Mac. In domain mode they
# listen on its loopback only, like every service behind the proxy, and
# the proxy reaches them through Docker's host gateway
# (host.docker.internal), the one route in from the LAN.

stt.{$STACK_DOMAIN} {
    reverse_proxy host.docker.internal:42062
}

openai.{$STACK_DOMAIN} {
    reverse_proxy host.docker.internal:42060
}
