#!/usr/bin/env bash
# stacktests — operate the integration test stack.
#
# The test rig uses the repo root as its instance (same layout as a
# real famstack: stack.toml, users.toml, .stack/ at the root). A
# sentinel `.stack/.test-instance` marks the repo as test-owned;
# running the rig over someone's real stack errors out instead of
# overwriting it.
#
# Usage (callable from anywhere — paths resolve off the script location):
#   tests/e2e/stacktests help            — this text, plus autonomy
#   tests/e2e/stacktests preflight       — offline gate: versions,
#                                                  lock, ruff, unit tests
#   tests/e2e/stacktests unverified      — list parked intent-specs
#   tests/e2e/stacktests ai [mode]       — show/flip the AI backend:
#                                                  mock | local | external
#   tests/e2e/stacktests up              — bring up what tests need
#   tests/e2e/stacktests down            — stop every test stacklet
#   tests/e2e/stacktests reset [slet]    — destroy + up (clean slate)
#   tests/e2e/stacktests cleanup         — nuke every test stacklet +
#                                                  instance state + test data
#   tests/e2e/stacktests stash           — set the dev instance aside
#                                                  and swap the test rig in
#   tests/e2e/stacktests unstash         — swap the rig out and bring
#                                                  the dev instance back up
#   tests/e2e/stacktests e2e [args]      — run every e2e test
#   tests/e2e/stacktests container-e2e   — alias for e2e
#   tests/e2e/stacktests smoke [args]    — run smoke e2e tests
#   tests/e2e/stacktests demo-rig [args] — run live Simpson demo tests
#   tests/e2e/stacktests demo [args]     — alias for demo-rig
#   tests/e2e/stacktests eval [args]     — pipeline quality eval
#                                                  (real model, report-only)
#   tests/e2e/stacktests pytest [args]   — pytest with env + deps
#   tests/e2e/stacktests <any stack cmd> — forward: logs, status...

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
# Defensive: clear any STACK_DIR the user may have exported pointing at
# a legacy test-instance path. The rig owns the repo root now.
unset STACK_DIR
export PYTHONPATH="$REPO_ROOT/lib"
cd "$REPO_ROOT"

# Interpreter: same rule as the ./stack wrapper — Apple's Command Line
# Tools ship python3 as 3.9, which lacks tomllib and often outranks
# Homebrew on PATH. Both `-m stack` and _seed_secrets.py import tomllib,
# so resolve once here rather than inheriting whatever `python3` means.
PYTHON=
for cand in python3.13 python3.12 python3.11 python3; do
  if command -v "$cand" >/dev/null 2>&1; then
    ver=$("$cand" -c 'import sys; print(sys.version_info[0]*100 + sys.version_info[1])' 2>/dev/null || echo 0)
    if [ "$ver" -ge 311 ]; then PYTHON="$cand"; break; fi
  fi
done
if [[ -z "$PYTHON" ]]; then
  echo "stacktests: needs Python 3.11+. Run ./stack for the install hint." >&2
  exit 1
fi

# Every rig operation goes through the real CLI, which is the sanctioned
# agent interface — so what a test drives is what an operator types.
stack_cli() { "$PYTHON" -m stack "$@"; }

# Stacklets the e2e tests need, in dependency order.
# - core: always_on, provides the bot-runner container that actually
#   executes the archivist bot (which then auto-creates #documents).
# - messages: Synapse + Element (Matrix backbone).
# - docs: Paperless-ngx + archivist bot definition.
# - code: Forgejo — archivist mirrors classified documents here.
REQUIRED_STACKLETS=(core messages docs code)

# Stacklets that `down` and `cleanup` deliberately leave alone. The
# ai stacklet downloads large models on install, which costs minutes
# of wall time and gigabytes of disk on every reinstall; across a day
# of iterative test runs that adds up. When an e2e test actually
# needs a fresh ai state, tear it down explicitly with
# `stacktests down ai` or `stack destroy ai --yes`.
PRESERVED_STACKLETS=(ai)

# Where `stash` parks a dev instance's root config, and the rig's between
# runs. Outside the repo, so no git operation can touch it.
STASH_DIR="${HOME}/famstack-stash"

# Stacklets of the instance at the repo root that are running, minus the
# preserved ones, comma separated for `stack down` / `stack up`.
running_stacklets() {
  stack_cli list --json | "$PYTHON" -c '
import json, sys
preserved = set(sys.argv[1:])
ids = [s["id"] for s in json.load(sys.stdin)["stacklets"]
       if (s.get("online") or s.get("starting") or s.get("degraded")) and s["id"] not in preserved]
print(",".join(ids))' "${PRESERVED_STACKLETS[@]}"
}

# Only the Simpsons demo is ever swapped out for a test run. Its Matrix
# server name is fixed at install and is in every user id, so a family's
# instance cannot carry it by accident.
DEMO_SERVER_NAME="simpson"

require_demo_instance() {
  local name
  name=$("$PYTHON" -c '
import sys, tomllib
with open(sys.argv[1], "rb") as f:
    print(tomllib.load(f).get("messages", {}).get("server_name", ""))' "$REPO_ROOT/stack.toml")
  if [[ "$name" != "$DEMO_SERVER_NAME" ]]; then
    echo "stacktests: refusing to stash the instance at the repo root." >&2
    echo "  stack.toml names the Matrix server '${name:-unset}', not '$DEMO_SERVER_NAME'." >&2
    echo "  Tests swap out the Simpsons demo only, never a family's instance." >&2
    exit 1
  fi
}

# Set the dev instance at the repo root aside so the rig can use the root.
#
# The rig and a dev instance share only the root config (stack.toml,
# users.toml, .stack/) and the container names. Their data dirs are
# separate (~/famstack-test-data vs the instance's own), so moving the
# three config entries and stopping the containers is the whole swap: no
# data is copied. The rig's config comes back from its own slot, so its
# secrets still match the test data it left behind.
stash_instance() {
  if [[ -f "$REPO_ROOT/.stack/.test-instance" ]]; then
    echo "stacktests: the repo root is already the test instance." >&2; exit 1
  fi
  if [[ ! -f "$REPO_ROOT/stack.toml" ]]; then
    echo "stacktests: no instance at the repo root to stash." >&2; exit 1
  fi
  require_demo_instance
  if [[ -e "$STASH_DIR/instance" ]]; then
    echo "stacktests: $STASH_DIR/instance already holds a stash." >&2
    echo "  Run 'stacktests unstash' first." >&2; exit 1
  fi

  local running
  running=$(running_stacklets)
  if [[ -n "$running" ]]; then
    echo "==> stack down $running"
    stack_cli down "$running"
  fi

  mkdir -p "$STASH_DIR/instance"
  echo "$running" > "$STASH_DIR/instance/running"
  mv "$REPO_ROOT/stack.toml" "$REPO_ROOT/users.toml" "$REPO_ROOT/.stack" "$STASH_DIR/instance/"
  echo "==> demo instance stashed in $STASH_DIR/instance"

  if [[ -d "$STASH_DIR/rig" ]]; then
    mv "$STASH_DIR/rig/stack.toml" "$STASH_DIR/rig/users.toml" "$STASH_DIR/rig/.stack" "$REPO_ROOT/"
    rmdir "$STASH_DIR/rig"
    echo "==> test rig config restored from $STASH_DIR/rig"
  fi
}

# Reverse of stash: park the rig's config in its slot, put the demo back
# and start what was running when it was stashed.
unstash_instance() {
  if [[ ! -d "$STASH_DIR/instance" ]]; then
    echo "stacktests: nothing stashed in $STASH_DIR/instance." >&2; exit 1
  fi

  local running
  if [[ -f "$REPO_ROOT/.stack/.test-instance" ]]; then
    running=$(running_stacklets)
    if [[ -n "$running" ]]; then
      echo "==> stack down $running (test rig)"
      stack_cli down "$running"
    fi
    mkdir -p "$STASH_DIR/rig"
    mv "$REPO_ROOT/stack.toml" "$REPO_ROOT/users.toml" "$REPO_ROOT/.stack" "$STASH_DIR/rig/"
    echo "==> test rig config kept in $STASH_DIR/rig"
  elif [[ -e "$REPO_ROOT/stack.toml" || -e "$REPO_ROOT/.stack" ]]; then
    echo "stacktests: the repo root holds an instance that is not the rig." >&2
    echo "  Refusing to overwrite it with the stash." >&2; exit 1
  fi

  running=$(cat "$STASH_DIR/instance/running")
  mv "$STASH_DIR/instance/stack.toml" "$STASH_DIR/instance/users.toml" "$STASH_DIR/instance/.stack" "$REPO_ROOT/"
  rm "$STASH_DIR/instance/running"
  rmdir "$STASH_DIR/instance"
  echo "==> demo instance restored"
  if [[ -n "$running" ]]; then
    echo "==> stack up $running"
    stack_cli up "$running"
  fi
}

# e2e and smoke need the rig at the repo root. When the demo is there
# instead, swap it out for the run and back afterwards, whatever the
# run's outcome. pytest then runs as a child rather than through exec,
# since exec would replace this shell and the trap with it.
use_rig() {
  if [[ -f "$REPO_ROOT/.stack/.test-instance" || ! -f "$REPO_ROOT/stack.toml" ]]; then
    return
  fi
  stash_instance
  trap 'rc=$?; trap - EXIT; unstash_instance; exit $rc' EXIT
  trap 'exit 130' INT TERM
}

# Bootstrap the repo root as a test instance and seed global secrets.
# Fails loudly if the repo root already holds a non-test stack.toml —
# see _seed_secrets.py's TestInstanceConflict message for the cleanup
# hint the user gets.
seed_secrets() {
  "$PYTHON" "$SCRIPT_DIR/_seed_secrets.py"
}

case "${1:-}" in
  up)
    # `./stacktests up`  — bring up the full set in order.
    # `./stacktests up X` — forward to `stack up X`.
    seed_secrets
    if [[ -z "${2:-}" ]]; then
      for sid in "${REQUIRED_STACKLETS[@]}"; do
        echo "==> stack up $sid"
        stack_cli up "$sid"
      done
    else
      shift
      stack_cli up "$@"
    fi
    ;;

  down)
    # Stop everything the tests care about, leaving PRESERVED_STACKLETS
    # (notably ai) running so their heavy state isn't thrown away. A
    # specific target on the command line is forwarded verbatim, so
    # `stacktests down ai` still works when a fresh ai state is wanted.
    shift || true
    if [[ -z "${1:-}" ]]; then
      for sid in "${REQUIRED_STACKLETS[@]}"; do
        echo "==> stack down $sid"
        stack_cli down "$sid" || true
      done
    else
      stack_cli down "$@"
    fi
    ;;

  reset)
    # Destroy + up — recover from a half-bootstrapped state without
    # hunting down setup markers or stale containers. --yes skips the
    # destroy confirmation because this is a test stack.
    shift || true
    if [[ -z "${1:-}" ]]; then
      targets=("${REQUIRED_STACKLETS[@]}")
    else
      targets=("$@")
    fi
    for sid in "${targets[@]}"; do
      echo "==> stack destroy $sid --yes"
      stack_cli destroy "$sid" --yes || true
    done
    for sid in "${targets[@]}"; do
      echo "==> stack up $sid"
      stack_cli up "$sid"
    done
    ;;

  stash)
    stash_instance
    ;;

  unstash)
    unstash_instance
    ;;

  pytest)
    # Run pytest with the test-deps extra and the env already set.
    shift
    exec uv run --extra test pytest "$@"
    ;;

  e2e|container-e2e)
    # Run every end-to-end test under tests/e2e/. Convention:
    # any file named test_*_e2e.py is picked up. Extra args forward to
    # pytest (e.g. `stacktests e2e -s -k homer`).
    #
    # `demo_rig`-marked tests are excluded: they target an already-live
    # Simpson demo instance (an ad-hoc feature-testing tool), not this
    # managed rig, so they'd fail here for want of a running demo. Run
    # them with `stacktests demo-rig` instead.
    #
    # Seeds secrets + brings up required stacklets first. Both steps
    # are idempotent, so repeat runs pay near-zero cost.
    shift || true
    use_rig
    seed_secrets
    for sid in "${REQUIRED_STACKLETS[@]}"; do
      stack_cli up "$sid" > /dev/null
    done
    uv run --extra test pytest tests/e2e/ -k "_e2e" -m "not demo_rig" --durations=20 "$@"
    ;;

  smoke)
    # Run the smoke subset of end-to-end tests. Like e2e, this seeds
    # secrets and ensures required stacklets are up before pytest starts.
    shift || true
    use_rig
    seed_secrets
    for sid in "${REQUIRED_STACKLETS[@]}"; do
      stack_cli up "$sid" > /dev/null
    done
    uv run --extra test pytest tests/e2e/ -k "_e2e" -m smoke "$@"
    ;;

  demo-rig|demo)
    # Run tests against the already-running Simpson demo instance in
    # this checkout. This deliberately does not seed config or start
    # stacklets; it should be safe to run repeatedly against live demo
    # data because tests create uniquely-named rooms/files and clean up
    # their own Paperless/Forgejo artifacts where the services allow it.
    shift || true
    exec uv run --extra test pytest tests/e2e/ -m demo_rig --durations=10 "$@"
    ;;

  eval)
    # Pipeline quality eval — uploads each case to a real Paperless,
    # waits for OCR, runs `enrich_document` against the live AI stacklet,
    # and prints a per-field scorecard. Report-only by design (always
    # passes) so prompt iteration is friction-free.
    #
    # Excluded from default pytest collection (see pyproject.toml's
    # `norecursedirs`). The only way in is this subcommand.
    #
    # Required env (set in your shell before running):
    #   AI_DEFAULT_MODEL — concrete model name to evaluate (e.g. "qwen3-14b")
    # Optional env:
    #   EVAL_AI_URL=http://localhost:42060/v1   AI endpoint (default shown)
    #   EVAL_AI_KEY=                            empty for unauthenticated local AI
    #   EVAL_KEEP_DOCS=1                        keep uploaded docs in Paperless
    #                                           after the run for inspection
    #
    # Per-run artifacts (OCR text, classification JSON, scorecard) are
    # always written to tests/e2e/eval/runs/<stamp>_<model>/.
    #
    # Pre-flight: requires `ai` to be up — fails fast with a clear
    # message rather than auto-installing models on someone's machine.
    #
    # Pytest args forward verbatim, so case selection is just `-k <expr>`:
    #   stacktests eval -k rechnung           one case
    #   stacktests eval -k 'rezept or kassenbon'   subset by substring
    #   stacktests eval --collect-only -q     list available cases
    shift || true
    seed_secrets
    for sid in "${REQUIRED_STACKLETS[@]}"; do
      stack_cli up "$sid" > /dev/null
    done
    exec uv run --extra test pytest -s -v tests/e2e/eval/ "$@"
    ;;

  cleanup)
    # Nuke everything test-related so the next `up` starts from zero.
    #   1. Destroy each stacklet (containers, per-stacklet secrets,
    #      per-stacklet data dir, setup marker).
    #   2. Wipe the test instance's .stack/ — clears global secrets
    #      (ADMIN_PASSWORD, user passwords) that survive per-stacklet
    #      destroy by design.
    #   3. Wipe the test data directory — catches detritus from runs
    #      that aborted before destroy could clean per-stacklet.
    #
    # Scope is confined to the test-owned repo root and ~/famstack-test-data.
    # The .test-instance sentinel confirms we're touching a test-owned repo,
    # so a real user's famstack at the same path would need to be cleaned up
    # by hand before this ever ran (guarded by _seed_secrets.py).

    shift || true
    TEST_DATA_DIR="${HOME}/famstack-test-data"

    for sid in "${REQUIRED_STACKLETS[@]}"; do
      echo "==> stack destroy $sid --yes"
      stack_cli destroy "$sid" --yes || true
    done

    # Belt and suspenders: force-remove any stack-<id>-* containers that
    # survived destroy (e.g. if compose_down silently errored). Without
    # this, a lingering container talking to a wiped data dir confuses
    # the next `up` into a schema-mismatch crash loop.
    for sid in "${REQUIRED_STACKLETS[@]}"; do
      leftovers=$(docker ps -aq --filter "name=^stack-${sid}-" 2>/dev/null || true)
      if [[ -n "$leftovers" ]]; then
        echo "==> docker rm -f (leftover stack-${sid}-* containers)"
        echo "$leftovers" | xargs docker rm -f || true
      fi
    done

    # Only remove repo root state if we own it (sentinel present).
    # Setup markers and data for PRESERVED_STACKLETS are kept so the
    # heavy state (ai's model downloads) survives a cleanup cycle.
    if [[ -f "$REPO_ROOT/.stack/.test-instance" ]]; then
      # Build a find exclusion list for the preserved-stacklet markers
      # plus the .test-instance sentinel itself. Every other entry
      # under .stack/ (global secrets, other setup markers) is wiped.
      preserve_args=(! -name '.test-instance')
      for sid in "${PRESERVED_STACKLETS[@]}"; do
        preserve_args+=(! -name "${sid}.*")
      done
      echo "==> clean $REPO_ROOT/.stack (preserving: ${PRESERVED_STACKLETS[*]})"
      find "$REPO_ROOT/.stack" -mindepth 1 -maxdepth 1 \
        "${preserve_args[@]}" -exec rm -rf {} +
      for f in stack.toml users.toml; do
        if [[ -f "$REPO_ROOT/$f" ]]; then
          echo "==> rm $REPO_ROOT/$f"
          rm -f "$REPO_ROOT/$f"
        fi
      done
    else
      echo "==> skipping repo-root cleanup (no .stack/.test-instance sentinel)"
    fi

    if [[ -d "$TEST_DATA_DIR" ]]; then
      data_preserve_args=()
      for sid in "${PRESERVED_STACKLETS[@]}"; do
        data_preserve_args+=(! -name "$sid")
      done
      echo "==> clean $TEST_DATA_DIR (preserving: ${PRESERVED_STACKLETS[*]})"
      find "$TEST_DATA_DIR" -mindepth 1 -maxdepth 1 \
        "${data_preserve_args[@]}" -exec rm -rf {} + 2>/dev/null || true
    fi

    echo ""
    echo "✓ Test stack cleaned. Next 'stacktests up' starts fresh."
    echo "   (preserved across cleanup: ${PRESERVED_STACKLETS[*]})"
    ;;

  preflight)
    # The autonomous gate. Everything here is offline and side-effect
    # free, so an agent may run it unattended, on any branch, at any
    # time — and must, before claiming a change is done.
    #
    # Deliberately the same checks the tag-triggered CI gate runs, in
    # the same order, so "green locally" and "green in CI" cannot drift.
    shift || true
    echo "==> version consistency"
    "$PYTHON" "$SCRIPT_DIR/_check_versions.py"
    echo "==> uv lock --check"
    uv lock --check
    echo "==> ruff"
    uvx ruff check .
    echo "==> unit tests"
    # Delegate to `make test-unit` rather than re-spelling the pytest
    # invocation. It carries an --ignore for the Docker lifecycle tests;
    # a second copy of that argument list drifted from this one within a
    # day, quietly pulling Docker into what is meant to be the offline gate.
    make test-unit
    echo ""
    echo "✓ preflight green — safe to commit."
    ;;

  ai)
    # Flip the AI backend: mock (httpserver fixture, offline, deterministic),
    # local (self-hosted endpoint - real quality without waiting on the ai
    # stacklet to load weights), or external (hosted, costs money per call).
    # No argument prints the current mode. See _ai_mode.py for the env vars
    # local/external read, and why endpoints are not committed.
    shift || true
    exec "$PYTHON" "$SCRIPT_DIR/_ai_mode.py" "$@"
    ;;

  unverified)
    # List every parked intent-spec. These are xfail-marked tests that
    # describe behaviour we believe works but have never run green on
    # the rig. Without this command they decay silently: the marker is
    # write-only, so nobody notices a spec parked for months.
    # Collection-only, so it needs no rig and no Docker.
    shift || true
    echo "Parked intent-specs (marker: unverified)"
    echo "Each one is a claim that nothing currently proves."
    echo ""
    uv run --extra test pytest tests/ -m unverified --collect-only -q "$@" || true
    ;;

  help|--help|-h)
    # An agent's first instinct is --help. Before this existed, that
    # fell through to the forward-to-stack case and died on whatever
    # `python3` happened to mean. A mystery interface is a bug.
    # Read the header block itself rather than restating it — line 2 to
    # the first blank line, so editing the usage above updates --help.
    sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'
    cat <<'EOF'
Autonomy — what an agent may run unattended:

  autonomous   Offline, no Docker, no shared state. Run freely.
               preflight, unverified, help, ai (show/flip)

               `ai local` is self-hosted: free, unmetered, just slower
               than a stub. Prefer it. `ai external` bills per call.

  shared       Uses the one dev instance. Agents may run these — this
               repo root is the Simpsons dev rig, not anyone's real
               famstack. Ports are fixed, so exactly one run at a time:
               check nothing else is mid-run before starting.
               up, down, e2e, smoke, demo-rig, eval, stash, unstash

               e2e and smoke need the root to be the test instance. On
               the Simpsons demo they stash it for the run and unstash
               it afterwards, pass or fail; `stash`/`unstash` do the same
               by hand, to keep the rig up for a look after a failure.
               Any other instance is refused. The swap moves config only
               and leaves both data dirs alone.

  destructive  Wipes state that re-running cannot recover.
               reset, cleanup, down ai

Start with `preflight`. It is the whole offline gate in one command.
EOF
    ;;

  "")
    stack_cli
    ;;

  *)
    # Anything else — forward untouched to stack.
    stack_cli "$@"
    ;;
esac
