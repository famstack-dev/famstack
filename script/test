#!/usr/bin/env bash
# script/test — run one test lane.
#
#   script/test [lane] [pytest args]    lane defaults to unit
#   script/test help                    the lanes, what each costs, when to run it
#
# One name per lane. `make <target>` calls this, so the two never disagree.

set -euo pipefail

cd "$(dirname "$0")/.."

PYTEST=(uv run --extra test pytest)

# Kept out of the unit lane because they drive the host, not Python:
# Docker for the one, `hdiutil` mounting an APFS image per test for the
# other, which alone was a third of the unit lane's time.
SLOW_FILES=(
  tests/framework/test_config_to_container.py
  tests/stacklets/test_backup_e2e.py
)

lanes() {
  cat <<'EOF'

  Linting is automatic: the hooks run ruff on staged files and check
  the commit subject. Nothing to remember per commit.

  Run the cheapest lane that proves what you changed.

  LANE                   TIME    NEEDS          EXCLUSIVE  RUN IT WHEN
  script/test lint       <1s     nothing        no         the whole tree, when you want it
  script/test unit       ~50s    nothing        no         before a push, or when a piece of work is done
  script/test lifecycle  ~6m     Docker, APFS   yes        lifecycle, env, compose, ports, health, backup
  script/test demo       ~4m     demo instance  yes        it must work against the running bots
  script/test smoke      ?       rig or demo    yes        quick cross-service check
  script/test e2e        ?       rig or demo    yes        end of a branch, before review

  script/test typecheck          types across the shipped code, not a gate

  Exclusive means it owns fixed container names and ports, so exactly
  one run at a time on this Mac. ? means nobody has timed it yet;
  if you run one, write the number down. Details: tests/README.md

EOF
}

lane="${1:-unit}"
shift || true

case "$lane" in
  help|-h|--help)
    lanes
    ;;

  # The whole tree, the way CI runs it. Per commit the hook already covers
  # the staged files, which is faster and is why nothing here is per commit.
  lint)
    script/setup --hooks-only
    uvx ruff check . "$@"
    ;;

  # Not a gate: read what it says about the files you touched.
  # `uvx basedpyright <paths>` narrows it further.
  typecheck)
    script/setup --hooks-only
    uvx basedpyright "$@" || true
    ;;

  # Offline. No Docker, no live services, nothing shared. Fast enough to run
  # when a piece of work is finished, too slow to run on every commit.
  unit)
    script/setup --hooks-only
    "${PYTEST[@]}" tests/framework tests/stacklets -v \
      "${SLOW_FILES[@]/#/--ignore=}" "$@"
    ;;

  # What the host itself provides: the Docker lifecycle (up, down, destroy,
  # env rendering, container environment) on its own throwaway instance,
  # with fixed names and ports, and the backup engine against real APFS
  # disk images, which it creates and mounts one per test.
  lifecycle)
    "${PYTEST[@]}" "${SLOW_FILES[@]}" -v "$@"
    ;;

  # Against the demo instance already running in this checkout. Tests create
  # unique data and clean up after themselves; they never reset the instance.
  demo)
    tests/integration/stacktests demo-rig "$@"
    ;;

  # The managed rig. On the Simpsons demo, stacktests stashes it for the run.
  smoke)
    tests/integration/stacktests smoke "$@"
    ;;
  e2e)
    tests/integration/stacktests e2e "$@"
    ;;

  *)
    echo "script/test: unknown lane '$lane'" >&2
    lanes >&2
    exit 1
    ;;
esac
